# معرّف المتجر داخل قاعدة Firestore المشتركة: stores/{VITE_STORE_ID}
# إلزامي. بدونه يعمل التطبيق على مسار __unconfigured__ وترفض القواعد كل كتابة.
VITE_STORE_ID=your-store-id

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# وسيط صور CJ Dropshipping (Cloud Function في نفس المشروع)
VITE_CJ_IMAGE_PROXY_BASE=https://us-central1-your-project-id.cloudfunctions.net

# PayPal Configuration
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id
